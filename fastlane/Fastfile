default_platform(:ios)

platform :ios do
  desc "Build and upload Hapoel Hadera to App Store Connect"
  lane :release do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],
      is_key_content_base64: false
    )

    # Free a distribution-certificate slot: revoke certs created by previous CI
    # runs. Never touches the pre-existing certificate 6YUQ5USSD9.
    begin
      token = Spaceship::ConnectAPI::Token.create(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key: ENV["ASC_KEY_P8"]
      )
      Spaceship::ConnectAPI.token = token
      Spaceship::ConnectAPI::Certificate.all.each do |c|
        next unless ["DISTRIBUTION", "IOS_DISTRIBUTION"].include?(c.certificate_type)
        next if c.id == "6YUQ5USSD9"
        UI.message("Revoking old CI distribution certificate #{c.id}")
        Spaceship::ConnectAPI.delete_certificate(certificate_id: c.id)
      end
    rescue => e
      UI.important("Certificate cleanup skipped: #{e.message}")
    end

    keychain_path = File.expand_path("~/Library/Keychains/fastlane_tmp_keychain-db")

    cert(
      api_key: api_key,
      keychain_path: keychain_path,
      keychain_password: ""
    )
    sigh(api_key: api_key, app_identifier: "il.co.hapoelhadera.app", force: true)

    update_code_signing_settings(
      path: "pwa-shell.xcodeproj",
      use_automatic_signing: false,
      team_id: "YZTLGU87C6",
      bundle_identifier: "il.co.hapoelhadera.app",
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME],
      profile_uuid: lane_context[SharedValues::SIGH_UUID]
    )

    cocoapods

    build_number = ENV["GITHUB_RUN_NUMBER"] || "1"
    increment_build_number(build_number: build_number, xcodeproj: "pwa-shell.xcodeproj")

    gym(
      workspace: "pwa-shell.xcworkspace",
      scheme: "pwa-shell",
      export_method: "app-store",
      output_directory: "build",
      output_name: "hapoel-hadera.ipa",
      export_options: {
        provisioningProfiles: {
          "il.co.hapoelhadera.app" => lane_context[SharedValues::SIGH_NAME]
        }
      }
    )

    pilot(
      api_key: api_key,
      ipa: "build/hapoel-hadera.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end
