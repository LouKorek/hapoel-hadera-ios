default_platform(:ios)

platform :ios do
  desc "Build and upload Hapoel Hadera to App Store Connect"
  lane :release do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],
      is_key_content_base64: false
    )

    # Create/fetch App Store distribution certificate + provisioning profile
    cert(api_key: api_key)
    sigh(api_key: api_key, app_identifier: "il.co.hapoelhadera.app", force: true)

    update_code_signing_settings(
      path: "pwa-shell.xcodeproj",
      use_automatic_signing: false,
      team_id: "YZTLGU87C6",
      bundle_identifier: "il.co.hapoelhadera.app",
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME],
      profile_uuid: lane_context[SharedValues::SIGH_UUID]
    )

    cocoapods

    build_number = ENV["GITHUB_RUN_NUMBER"] || "1"
    increment_build_number(build_number: build_number, xcodeproj: "pwa-shell.xcodeproj")

    gym(
      workspace: "pwa-shell.xcworkspace",
      scheme: "pwa-shell",
      export_method: "app-store",
      output_directory: "build",
      output_name: "hapoel-hadera.ipa",
      export_options: {
        provisioningProfiles: {
          "il.co.hapoelhadera.app" => lane_context[SharedValues::SIGH_NAME]
        }
      }
    )

    pilot(
      api_key: api_key,
      ipa: "build/hapoel-hadera.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end
